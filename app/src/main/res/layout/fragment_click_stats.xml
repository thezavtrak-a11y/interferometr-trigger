<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/metro_bg"
    android:orientation="vertical"
    android:padding="12dp"
    tools:context=".ui.ClickStatsFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/click_stats_title"
            android:textAppearance="@style/TextAppearance.ArduHud.Title"
            android:textColor="@color/metro_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearStatsButton"
            style="@style/Widget.ArduHud.RectButton.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/click_stats_clear" />
    </LinearLayout>

    <TextView
        android:id="@+id/statsStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/metro_accent"
        android:textSize="13sp"
        tools:text="Запись: молния ON" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/click_stats_journal_title"
        android:textColor="@color/metro_text_secondary"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:background="@color/metro_chrome"
        android:fillViewport="true"
        android:padding="10dp">

        <TextView
            android:id="@+id/journalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/metro_text"
            android:textSize="12sp"
            tools:text="0.00  клик ×1  +A.Y" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/click_stats_summary_title"
        android:textColor="@color/metro_text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/summaryText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@color/metro_chrome"
        android:fontFamily="monospace"
        android:lineSpacingExtra="2dp"
        android:minHeight="96dp"
        android:padding="10dp"
        android:textColor="@color/metro_text"
        android:textSize="12sp"
        tools:text="Сессия 12.3 с · кликов 8" />
</LinearLayout>
