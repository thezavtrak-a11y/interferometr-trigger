<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tutorialCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:background="@color/metro_chrome"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tutorialProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/metro_accent"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tutorialTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@style/TextAppearance.ArduHud.Title"
        android:textColor="@color/metro_text"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tutorialBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textAppearance="@style/TextAppearance.ArduHud.Body"
        android:textColor="@color/metro_text_secondary"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tutorialBackButton"
            style="@style/Widget.ArduHud.RectButton.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tutorial_back" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tutorialFinishButton"
            style="@style/Widget.ArduHud.RectButton.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/tutorial_finish" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/tutorialNextButton"
            style="@style/Widget.ArduHud.RectButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/tutorial_next" />
    </LinearLayout>
</LinearLayout>
