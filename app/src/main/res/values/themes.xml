<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Windows Phone 10 / Metro chrome:
      black canvas, sharp rect tiles, cyan accent #00ADEF, no pills/elevation.
    -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/metro_accent</item>
        <item name="colorOnPrimary">@color/metro_text</item>
        <item name="colorPrimaryContainer">@color/metro_accent</item>
        <item name="colorOnPrimaryContainer">@color/metro_text</item>
        <item name="colorSecondary">@color/metro_accent</item>
        <item name="colorOnSecondary">@color/metro_text</item>
        <item name="colorSurface">@color/metro_chrome</item>
        <item name="colorOnSurface">@color/metro_text</item>
        <item name="colorOnSurfaceVariant">@color/metro_text_secondary</item>
        <item name="colorOutline">@color/metro_stroke</item>
        <item name="android:statusBarColor">@color/metro_bg</item>
        <item name="android:navigationBarColor">@color/metro_bg</item>
        <item name="android:windowBackground">@color/metro_bg</item>
        <item name="android:textColorPrimary">@color/metro_text</item>
        <item name="android:textColorSecondary">@color/metro_text_secondary</item>
        <item name="materialButtonStyle">@style/Widget.ArduHud.RectButton</item>
        <item name="borderlessButtonStyle">@style/Widget.ArduHud.RectButton.Text</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.ArduHud.RectButton.Outlined</item>
        <item name="textInputStyle">@style/Widget.ArduHud.TextInputLayout</item>
        <item name="chipStyle">@style/Widget.ArduHud.RectFilterChip</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />

    <style name="ShapeAppearance.ArduHud.Rect" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">0dp</item>
    </style>

    <!-- Filled accent tile (primary actions). -->
    <style name="Widget.ArduHud.RectButton" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ArduHud.Rect</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/metro_text</item>
        <item name="backgroundTint">@color/metro_accent</item>
        <item name="rippleColor">@color/metro_accent_pressed</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Idle / chrome tile (scale toggles, secondary). -->
    <style name="Widget.ArduHud.RectToggleButton" parent="Widget.ArduHud.RectButton">
        <item name="android:minHeight">36dp</item>
        <item name="backgroundTint">@color/metro_chrome_raised</item>
    </style>

    <style name="Widget.ArduHud.RectButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ArduHud.Rect</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/metro_text</item>
        <item name="strokeColor">@color/metro_accent</item>
        <item name="strokeWidth">2dp</item>
        <item name="rippleColor">@color/metro_accent_pressed</item>
        <item name="backgroundTint">@android:color/transparent</item>
    </style>

    <style name="Widget.ArduHud.RectButton.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ArduHud.Rect</item>
        <item name="cornerRadius">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/metro_accent</item>
        <item name="rippleColor">@color/metro_accent_pressed</item>
    </style>

    <!-- +/- nudge tiles on timing sliders. -->
    <style name="Widget.ArduHud.RectButton.Nudge" parent="Widget.ArduHud.RectToggleButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/metro_text</item>
    </style>

    <style name="Widget.ArduHud.RectFilterChip" parent="Widget.MaterialComponents.Chip.Filter">
        <item name="chipCornerRadius">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.ArduHud.Rect</item>
        <item name="chipMinHeight">32dp</item>
        <item name="chipBackgroundColor">@color/metro_chrome_raised</item>
        <item name="android:textColor">@color/metro_text</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/metro_stroke</item>
        <item name="rippleColor">@color/metro_accent_pressed</item>
    </style>

    <style name="Widget.ArduHud.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">0dp</item>
        <item name="boxCornerRadiusTopEnd">0dp</item>
        <item name="boxCornerRadiusBottomStart">0dp</item>
        <item name="boxCornerRadiusBottomEnd">0dp</item>
        <item name="boxStrokeColor">@color/metro_accent</item>
        <item name="hintTextColor">@color/metro_accent</item>
        <item name="android:textColorHint">@color/metro_text_secondary</item>
    </style>

    <style name="TextAppearance.ArduHud.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/metro_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.ArduHud.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/metro_text</item>
    </style>

    <style name="TextAppearance.ArduHud.Secondary" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/metro_text_secondary</item>
    </style>

    <style name="TextAppearance.ArduHud.Caption" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/metro_text_secondary</item>
    </style>

    <!-- Dot-name base so Widget.ArduHud.* without explicit parent resolve. -->
    <style name="Widget.ArduHud" parent="" />

    <!-- Oscilloscope toolbar: sharp tile hit-target, icon tinted in code when active. -->
    <style name="Widget.ArduHud.ToolbarIcon" parent="Widget.ArduHud">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginStart">2dp</item>
        <item name="android:background">@drawable/bg_metro_icon_button</item>
        <item name="android:padding">6dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/metro_text</item>
    </style>
</resources>
